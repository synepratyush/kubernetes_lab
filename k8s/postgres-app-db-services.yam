apiVersion: v1
kind: Service
metadata:
  name: postgres-primary
spec:
  selector:
    statefulset.kubernetes.io/pod-name: postgres-0
  ports:
  - port: 5432
    targetPort: 5432
---
apiVersion: v1
kind: Service
metadata:
  name: postgres-replica1
spec:
  selector:
    statefulset.kubernetes.io/pod-name: postgres-1
  ports:
  - port: 5432
    targetPort: 5432
---
apiVersion: v1
kind: Service
metadata:
  name: postgres-replica2
spec:
  selector:
    statefulset.kubernetes.io/pod-name: postgres-2
  ports:
  - port: 5432
    targetPort: 5432